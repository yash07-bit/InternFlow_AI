# ─────────────────────────────────────────────────────────────────────────────
# InternFlow AI — environment variables
# Copy to `.env` in the repo root. Every variable is optional: with no .env at all
# the app runs fully in Demo Mode with the local planner and a JSON-file database.
# ─────────────────────────────────────────────────────────────────────────────

# --- Server ------------------------------------------------------------------
API_PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# Demo Mode is the default for new installs (toggle it in the UI header).
DEMO_MODE=true
# Artificial latency (ms) for mock integrations so the live timeline is watchable.
DEMO_LATENCY_MS=700
# IANA timezone used for follow-up scheduling (defaults to the machine timezone).
USER_TIMEZONE=Asia/Kolkata

# --- AI ----------------------------------------------------------------------
# auto      → Claude when ANTHROPIC_API_KEY is set, otherwise the local deterministic planner
# anthropic → always Claude (requires ANTHROPIC_API_KEY)
# local     → always the local planner (no network, no key)
AI_PROVIDER=auto
AI_MODEL=claude-opus-5
# low | medium | high | xhigh | max
AI_EFFORT=medium
AI_MAX_TURNS=24
ANTHROPIC_API_KEY=

# --- Database ----------------------------------------------------------------
# Data is stored in a zero-setup JSON file (backend/data/internflow.json by default).
DATA_DIR=
# Reserved for a future PostgresStore (not implemented yet — leave empty).
DATABASE_URL=

# --- Security ----------------------------------------------------------------
# 32+ random characters. Encrypts OAuth tokens at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret
RATE_LIMIT_RUNS_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=300

# --- Google (Gmail + Drive + Calendar) ---------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
# Enable: Gmail API, Google Drive API, Google Calendar API
# Authorized redirect URI must equal GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback

# --- Notion (application tracker) --------------------------------------------
# Option A (simplest): internal integration token + a database shared with it.
NOTION_API_KEY=
NOTION_DATABASE_ID=
# Option B: public integration OAuth.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:4000/api/integrations/notion/callback
